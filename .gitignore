# Exclude everything
/*

# Except for default project files
!/.github
!/build-aux
!/cmake
!/data
!/docs
!/src
!.clang-format
!.gersemirc
!.gitignore
!buildspec.json
!CMakeLists.txt
!CMakePresets.json
!LICENSE
!README.md
!THIRD-PARTY-NOTICES.md
!MODIFICATIONS.md
!/third-party
!/tools
/tools/*
!/tools/prepare_portable_toolchain.py
!/tools/Enter-TRUEITEMBuild.ps1
!/tools/vs-catalog.json
!/tools/README.md

# Exclude lock files
*.lock.json

# Exclude macOS legacy resource forks
.DS_Store

# Exclude CMake build number cache
/cmake/.CMakeBuildNumber

.docs
